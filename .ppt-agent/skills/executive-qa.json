{
  "name": "executive-qa",
  "description": "汇报PPT质量检查规范",
  "version": "1.0.0",
  "type": "validation",
  "agent_scope": ["qa"],
  "rules": [
    "检查逻辑连贯性：每个章节是否承上启下",
    "验证数据准确性：数据来源是否可靠",
    "确保时间控制：每页1-2分钟，总计15-20分钟",
    "检查专业术语一致性",
    "验证图表是否清晰易懂",
    "检查是否有错别字和语法错误",
    "确保格式统一",
    "验证链接和引用是否正确"
  ],
  "checklist": {
    "cover": [
      "主题是否清晰",
      "副标题是否说明范围",
      "汇报人信息是否完整",
      "日期是否正确"
    ],
    "agenda": [
      "目录是否清晰",
      "章节顺序是否合理",
      "预计时间是否合理"
    ],
    "content": [
      "每个章节是否有明确结论",
      "数据是否有来源说明",
      "图表是否清晰易懂",
      "要点是否简洁有力"
    ],
    "summary": [
      "总结是否概括要点",
      "建议是否具体可执行",
      "下一步是否明确"
    ],
    "overall": [
      "逻辑是否连贯",
      "风格是否统一",
      "时间是否控制在15-20分钟",
      "是否有错别字"
    ]
  },
  "quality_metrics": {
    "logic_score": {
      "description": "逻辑连贯性评分",
      "weight": 0.25,
      "threshold": 0.8
    },
    "data_accuracy": {
      "description": "数据准确性评分",
      "weight": 0.25,
      "threshold": 0.9
    },
    "clarity": {
      "description": "清晰度评分",
      "weight": 0.20,
      "threshold": 0.8
    },
    "professionalism": {
      "description": "专业度评分",
      "weight": 0.15,
      "threshold": 0.8
    },
    "completeness": {
      "description": "完整性评分",
      "weight": 0.15,
      "threshold": 0.9
    }
  },
  "common_issues": [
    {
      "issue": "数据来源不明",
      "severity": "high",
      "fix": "添加数据来源说明"
    },
    {
      "issue": "要点过多",
      "severity": "medium",
      "fix": "精简要点，每页不超过5个"
    },
    {
      "issue": "图表不清晰",
      "severity": "medium",
      "fix": "简化图表，突出关键信息"
    },
    {
      "issue": "结论模糊",
      "severity": "high",
      "fix": "明确结论，避免模糊表述"
    },
    {
      "issue": "时间超限",
      "severity": "medium",
      "fix": "精简内容，控制在15-20分钟"
    }
  ]
}
