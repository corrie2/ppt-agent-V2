OPENAI_API_KEY=
PPT_AGENT_MODEL=gpt-5.4
PPT_AGENT_WORKSPACE=.ppt-agent

# Project-scoped long-term memory database infrastructure.
# This is not wired into the agent, CLI, skills, or existing JSON/JSONL memory.
PPT_AGENT_VECTOR_MEMORY=0
PPT_AGENT_MEMORY_DB_HOST=localhost
PPT_AGENT_MEMORY_DB_PORT=54329
PPT_AGENT_MEMORY_DB_NAME=ppt_agent_memory
PPT_AGENT_MEMORY_DB_USER=ppt_agent
PPT_AGENT_MEMORY_DB_PASSWORD=ppt_agent
PPT_AGENT_MEMORY_DATABASE_URL=postgresql://ppt_agent:ppt_agent@localhost:54329/ppt_agent_memory
PPT_AGENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
